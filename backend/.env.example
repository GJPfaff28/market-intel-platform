# Copy this file to .env and fill in your real keys.
# See README.md "Getting API keys" for a step-by-step walkthrough.

# Alpaca (free tier: real-time IEX quotes + free Benzinga-powered news)
# Sign up at https://alpaca.markets -> Paper/Live account -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Free-tier data feed is IEX; switch to "sip" only on a paid plan.
ALPACA_DATA_FEED=iex

# Finnhub (free tier: earnings calendar, analyst actions, insider activity)
# Sign up at https://finnhub.io/register
FINNHUB_API_KEY=

# SQLite database file location (relative to backend/ by default)
DATABASE_URL=sqlite:///./scanner.db

# Broader market scan filters (from PLANNING.md)
SCAN_MIN_PRICE=8
SCAN_MIN_AVG_VOLUME=2000000
SCAN_MIN_RVOL=2.0
